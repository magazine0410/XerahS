<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShareX.ImageShack.Plugin.ViewModels"
             x:Class="ShareX.ImageShack.Plugin.Views.ImageShackConfigView"
             x:DataType="vm:ImageShackConfigViewModel">

    <UserControl.Styles>
        <Style Selector="Border.heroCard">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
            <Border Classes="heroCard">
                <StackPanel Spacing="8">
                    <TextBlock Text="ImageShack" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Upload images to your ImageShack account, as in ShareX. Log in with your ImageShack username and password to get an auth token. ImageShack also requires an API key: ShareX's release builds include their own, XerahS needs yours."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" MaxWidth="680"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="15">
                    <TextBlock Text="API key" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="API key *"/>
                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" PasswordChar="*" PlaceholderText="Stored in the secret store"/>
                        <TextBlock Classes="helper" Text="ImageShack gives API keys on request."/>
                    </StackPanel>
                    <Button Content="Request API Key" Command="{Binding OpenApiKeyRequestCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="15">
                    <TextBlock Text="Account" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="Username"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="Password"/>
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" PasswordChar="*" PlaceholderText="Stored in the secret store"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="fieldLabel" Text="Status:" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel>
                        <Button Content="Log In" Command="{Binding LogInCommand}" IsEnabled="{Binding !IsBusy}" Margin="0,0,8,8"/>
                        <Button Content="Public Profile" Command="{Binding OpenPublicProfileCommand}" Margin="0,0,8,8"/>
                        <Button Content="My Images" Command="{Binding OpenMyImagesCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="15">
                    <TextBlock Text="Upload" FontSize="16" FontWeight="SemiBold"/>
                    <CheckBox Content="Public" IsChecked="{Binding IsPublic}"/>
                    <Grid ColumnDefinitions="160,12,160">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="fieldLabel" Text="Thumbnail width"/>
                            <NumericUpDown Value="{Binding ThumbnailWidth}" Minimum="0" Maximum="10000" Increment="1" FormatString="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Classes="fieldLabel" Text="Thumbnail height"/>
                            <NumericUpDown Value="{Binding ThumbnailHeight}" Minimum="0" Maximum="10000" Increment="1" FormatString="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
