<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShareX.Upaste.Plugin.ViewModels"
             x:Class="ShareX.Upaste.Plugin.Views.UpasteConfigView"
             x:DataType="vm:UpasteConfigViewModel">

    <UserControl.Styles>
        <Style Selector="Border.heroCard">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
            <Border Classes="heroCard">
                <StackPanel Spacing="8">
                    <TextBlock Text="uPaste" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Upload text to your uPaste account. uPaste's API now requires a key for every request, so a user key is required."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" MaxWidth="680"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="15">
                    <TextBlock Text="Account" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="User key"/>
                        <TextBox Text="{Binding UserKey, UpdateSourceTrigger=PropertyChanged}" PasswordChar="*"
                                 PlaceholderText="Required; stored in the secret store"/>
                        <TextBlock Classes="helper" Text="Create a key in your uPaste account settings. uPaste shows it only once."/>
                    </StackPanel>
                    <Button Content="Open Account Settings" Command="{Binding OpenAccountPageCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Paste" FontSize="16" FontWeight="SemiBold"/>
                    <CheckBox Content="Is public" IsChecked="{Binding IsPublic}"/>
                    <TextBlock Classes="helper" Text="Without it, pastes are unlisted. uPaste currently stores public pastes as unlisted too."/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
