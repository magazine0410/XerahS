<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShareX.ImgBB.Plugin.ViewModels"
             x:Class="ShareX.ImgBB.Plugin.Views.ImgBBConfigView"
             x:DataType="vm:ImgBBConfigViewModel">

    <UserControl.Styles>
        <Style Selector="Border.heroCard">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.helper">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18">
            <Border Classes="heroCard">
                <StackPanel Spacing="8">
                    <TextBlock Text="ImgBB" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Upload images to ImgBB (up to 32 MB each) with its API. The result gives the image link, a thumbnail, and a deletion link."
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" MaxWidth="680"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="15">
                    <TextBlock Text="Account" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="API key *"/>
                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" PasswordChar="*" PlaceholderText="Stored in the secret store"/>
                        <TextBlock Classes="helper" Text="Sign in to ImgBB and get a free API key on its API page."/>
                    </StackPanel>
                    <Button Content="Get API Key" Command="{Binding OpenApiKeyPageCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="15">
                    <TextBlock Text="Upload" FontSize="16" FontWeight="SemiBold"/>
                    <CheckBox Content="Direct link (link to the image instead of its page)" IsChecked="{Binding DirectLink}"/>
                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="Auto delete"/>
                        <ComboBox ItemsSource="{Binding ExpirationOptions}" SelectedItem="{Binding SelectedExpiration}" MinWidth="220"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
