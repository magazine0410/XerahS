<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.ViewModels"
             xmlns:views="using:XerahS.UI.Views"
             xmlns:controls="using:XerahS.UI.Controls"
             xmlns:imagefx="clr-namespace:ShareX.ImageEditor.Core.ImageEffects;assembly=ShareX.ImageEditor"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="XerahS.UI.Views.ImageEffectsEditorPanel"
             x:DataType="vm:ImageEffectsViewModel">
    <!-- Preset editor shared by Task settings > Image > Effects and the Image effects tool window. -->
    <Grid RowDefinitions="Auto, *" Margin="8">
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Margin="0,0,0,16" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*, Auto" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Preset:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding PresetNames}" SelectedIndex="{Binding SelectedPresetIndex, Mode=TwoWay}" MinWidth="130" AutomationProperties.Name="Image effect preset"/>
                    <TextBox Text="{Binding Name, Mode=TwoWay}" MinWidth="130" AutomationProperties.Name="Preset name"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding ImportEffectsCommand}" Content="Import..." AutomationProperties.Name="Import Image Effects Preset"/>
                    <Button Command="{Binding SavePresetCommand}" Content="Export..." AutomationProperties.Name="Export Image Effects Preset"/>
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <Button Content="New" Command="{Binding NewPresetCommand}" Margin="0,0,8,0"/>
                    <Button Content="Duplicate" Command="{Binding DuplicatePresetCommand}" Margin="0,0,8,0"/>
                    <Button Content="Remove preset" Command="{Binding RemovePresetCommand}" Margin="0,0,8,0"/>
                    <Button Content="Move preset up" Command="{Binding MovePresetUpCommand}" Margin="0,0,8,0"/>
                    <Button Content="Move preset down" Command="{Binding MovePresetDownCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="1.1*, 16, 1.1*, 16, 1.3*" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Effects List -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto">
                <TextBlock Grid.Row="0" Text="Active Effects" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <ListBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="Active Effects List">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="imagefx:ImageEffect">
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Command="{Binding $parent[views:ImageEffectsEditorPanel].((vm:ImageEffectsViewModel)DataContext).ToggleEffectCommand}"
                                          CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add Effect" Command="{Binding OpenEffectBrowserDialogCommand}" AutomationProperties.Name="Add Effect Browser"/>
                    <Button Command="{Binding RemoveEffectCommand}" Content="Remove" AutomationProperties.Name="Remove Selected Effect"/>
                    <Button Content="Up" Command="{Binding MoveEffectUpCommand}" AutomationProperties.Name="Move effect up"/>
                    <Button Content="Down" Command="{Binding MoveEffectDownCommand}" AutomationProperties.Name="Move effect down"/>
                </WrapPanel>
            </Grid>

            <!-- Properties -->
            <Grid Grid.Column="2" RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="Properties" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="8">
                    <controls:PropertyGrid x:Name="EffectPropertyGrid" SelectedObject="{Binding SelectedEffect}" AutomationProperties.Name="Effect Properties"/>
                </Border>
            </Grid>

            <!-- Preview -->
            <Grid Grid.Column="4" RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0" Text="Preview" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" MinHeight="260">
                    <Grid>
                        <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" Margin="10" AutomationProperties.Name="Effect Preview"/>
                        <TextBlock Text="{Binding PreviewError}" IsVisible="{Binding HasPreviewError}" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
