<views:SurfaceWindow xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:XerahS.UI.Views" xmlns:vm="using:XerahS.UI.ViewModels"
    x:Class="XerahS.UI.Views.BeforeUploadWindow" x:DataType="vm:BeforeUploadViewModel"
    Title="Before upload" Width="850" Height="560" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterScreen">
    <Border Padding="20" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
        <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="260,*" RowSpacing="12" ColumnSpacing="16">
            <TextBlock Text="Before upload" FontSize="22" FontWeight="SemiBold" Grid.ColumnSpan="2"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Prompt}" TextWrapping="Wrap"/>
            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Destination" FontWeight="SemiBold"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}" AutomationProperties.Name="Upload destination">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:BeforeUploadDestination">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid RowDefinitions="*,Auto" RowSpacing="8">
                    <Image Source="{Binding Preview}" Stretch="Uniform" IsVisible="{Binding HasPreview}" PointerPressed="OnPreview" Cursor="Hand" AutomationProperties.Name="Upload preview">
                        <Image.ContextFlyout><MenuFlyout><MenuItem Header="Copy image" Click="OnCopy"/></MenuFlyout></Image.ContextFlyout>
                    </Image>
                    <TextBlock Text="No image preview" IsVisible="{Binding !HasPreview}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="{Binding ImageSize}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" IsCancel="True" Click="OnCancel"/>
                <Button Content="Upload" IsDefault="True" Click="OnUpload" IsEnabled="{Binding CanUpload}"/>
            </StackPanel>
        </Grid>
    </Border>
</views:SurfaceWindow>
