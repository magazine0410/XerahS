<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:views="using:XerahS.UI.Views"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
                x:Class="XerahS.UI.Views.ToolsView">

    <!-- ShareX's Tools grid: the tools by category, and Edit to choose which ones the menus show. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" RowDefinitions="Auto,*" RowSpacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Tools" Theme="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="EditButton" Content="Edit" Click="OnEditClick"
                        ToolTip.Tip="Choose the tools that the Tools menus show"
                        AutomationProperties.Name="Edit Tools"/>
            </Grid>
            <StackPanel Grid.Row="1" x:Name="CategoriesPanel" Spacing="6"/>
        </Grid>
    </ScrollViewer>
</views:PageView>
