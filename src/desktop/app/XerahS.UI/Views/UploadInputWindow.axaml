<views:SurfaceWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="using:XerahS.UI.Views"
                     x:Class="XerahS.UI.Views.UploadInputWindow"
                     Width="620" MinWidth="400" MinHeight="220"
                     WindowStartupLocation="CenterScreen">
    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" Padding="24">
        <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16">
            <TextBlock x:Name="InputLabel" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" x:Name="Input" VerticalContentAlignment="Top"
                     AutomationProperties.Name="Content to upload"/>
            <TextBlock Grid.Row="2" x:Name="Validation" IsVisible="False" TextWrapping="Wrap"/>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="CharacterCount" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Cancel" IsCancel="True" Click="OnCancel"/>
                    <Button x:Name="SubmitButton" Click="OnSubmit"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</views:SurfaceWindow>
