<ui:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:XerahS.UI.Views"
        xmlns:vm="using:XerahS.UI.ViewModels"
        xmlns:platform="using:XerahS.Platform.Abstractions"
        x:Class="XerahS.UI.Views.OcrWindow"
        x:DataType="vm:OcrViewModel"
        Title="OCR - Text Recognition"
        Width="720" Height="540"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="OCR Text Recognition Window">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">

    <!-- Options Bar -->
    <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="16" LineSpacing="8" Margin="0,0,0,12">

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Language:" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding AvailableLanguages}"
                  SelectedItem="{Binding SelectedLanguage}"
                  MinWidth="160"
                  AutomationProperties.Name="OCR Language">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="platform:OcrLanguage">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Scale:" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding ScaleFactorOptions}"
                  SelectedItem="{Binding ScaleFactor}"
                  MinWidth="70"
                  AutomationProperties.Name="Scale Factor" />
      </StackPanel>

      <CheckBox Content="Single line"
                IsChecked="{Binding SingleLine}"
                VerticalAlignment="Center"
                AutomationProperties.Name="Single line output mode" />

      <CheckBox Content="Copy recognized text automatically"
                IsChecked="{Binding AutoCopy}"
                VerticalAlignment="Center"
                AutomationProperties.Name="Copy recognized text automatically" />

    </WrapPanel>

    <!-- Services (ShareX's OCR service links) -->
    <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" Margin="0,0,0,12">
      <TextBlock Text="Service:" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding ServiceLinks}"
                SelectedItem="{Binding SelectedService}"
                MinWidth="180"
                PlaceholderText="Select a service"
                AutomationProperties.Name="OCR Service">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:OcrServiceLinkOption">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Content="Edit services"
              Command="{Binding ToggleEditServicesCommand}"
              AutomationProperties.Name="Edit services" />
      <Button Content="Open service..."
              Command="{Binding OpenServiceCommand}"
              AutomationProperties.Name="Open the recognized text in the service" />
      <CheckBox Content="Close after opening"
                IsChecked="{Binding CloseAfterOpeningService}"
                VerticalAlignment="Center"
                AutomationProperties.Name="Close the window after opening a service" />
    </WrapPanel>

    <Border Grid.Row="2" IsVisible="{Binding IsEditingServices}" Margin="0,0,0,12" Padding="12" CornerRadius="4" BorderThickness="1"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
      <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="8" ColumnSpacing="8">
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
          <Button Content="New" Command="{Binding NewServiceCommand}" AutomationProperties.Name="New service" />
          <Button Content="Remove" Command="{Binding RemoveServiceCommand}" AutomationProperties.Name="Remove service" />
          <Button Content="Reset" Command="{Binding ResetServicesCommand}" AutomationProperties.Name="Reset services" />
          <Button Content="Close" Command="{Binding ToggleEditServicesCommand}" AutomationProperties.Name="Close service editing" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Name:" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedService.Name, FallbackValue=''}" IsEnabled="{Binding HasSelectedService}"
                 AutomationProperties.Name="Service name" />
        <TextBlock Grid.Row="2" Text="URL:" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedService.Url, FallbackValue=''}" IsEnabled="{Binding HasSelectedService}"
                 PlaceholderText="Use {0} where the recognized text belongs"
                 AutomationProperties.Name="Service URL" />
      </Grid>
    </Border>

    <!-- Result Text Area -->
    <Grid Grid.Row="3">
      <TextBox Text="{Binding ResultText, Mode=TwoWay}"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               IsReadOnly="False"
               VerticalContentAlignment="Top"
               PlaceholderText="OCR result will appear here..."
               AutomationProperties.Name="OCR recognized text" />

      <!-- Processing overlay -->
      <Border Background="{DynamicResource XerahS.Brush.Overlay.Modal}"
              CornerRadius="4"
              IsVisible="{Binding IsProcessing}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
          <ProgressBar IsIndeterminate="True"
                       Width="200" />
          <TextBlock Text="Processing..."
                     Foreground="{DynamicResource XerahS.Brush.Overlay.Foreground}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Bottom Bar -->
    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0">

      <Button Grid.Column="0"
              Content="Select Region"
              Command="{Binding SelectRegionCommand}"
              MinWidth="110"
              AutomationProperties.Name="Select new screen region for OCR" />

      <Button Grid.Column="1"
              Content="Copy All"
              Command="{Binding CopyToClipboardCommand}"
              Classes="accent"
              Margin="8,0,0,0"
              MinWidth="90"
              IsEnabled="{Binding HasResult}"
              AutomationProperties.Name="Copy all recognized text to clipboard" />

      <TextBlock Grid.Column="3"
                 Text="{Binding StatusText}"
                 VerticalAlignment="Center"
                 Opacity="0.7"
                 FontSize="12" />
    </Grid>

  </Grid>

</ui:SurfaceWindow>
