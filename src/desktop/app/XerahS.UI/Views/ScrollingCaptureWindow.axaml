<ui:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:XerahS.UI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:XerahS.UI.ViewModels"
        xmlns:pa="using:XerahS.Platform.Abstractions"
        mc:Ignorable="d"
        d:DesignWidth="900" d:DesignHeight="650"
        x:Class="XerahS.UI.Views.ScrollingCaptureWindow"
        x:DataType="vm:ScrollingCaptureViewModel"
        Title="XerahS - Scrolling capture"
        Width="900" Height="650"
        MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        CanResize="True">

  <!-- Layout and wording follow ShareX's scrolling capture window. -->
  <Grid>
    <Grid RowDefinitions="Auto,*,Auto" Margin="12" RowSpacing="8">

      <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="6">
        <Button Grid.Column="0" Content="Capture..." Command="{Binding CaptureCommand}" IsEnabled="{Binding CanUseControls}"
                Classes="accent" AutomationProperties.Name="Capture scrolling content"/>
        <Button Grid.Column="1" Content="Upload / Save" Command="{Binding UploadCommand}" IsEnabled="{Binding CanUseResult}"/>
        <Button Grid.Column="2" Content="Copy" Command="{Binding CopyToClipboardCommand}" IsEnabled="{Binding CanUseResult}"/>
        <Button Grid.Column="3" Content="Options..." Command="{Binding OpenOptionsCommand}" IsEnabled="{Binding CanUseControls}"/>
        <Button Grid.Column="5" Content="?" Width="34" MinWidth="34" HorizontalContentAlignment="Center"
                Command="{Binding OpenHelpCommand}" ToolTip.Tip="Scrolling screenshot help"
                AutomationProperties.Name="Scrolling screenshot help"/>
      </Grid>

      <Border Grid.Row="1"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="4"
              ClipToBounds="True">
        <Panel>
          <TextBlock Text="Select a scrollable window to begin"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     IsVisible="{Binding !HasResult}"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding HasResult}">
            <Image Source="{Binding PreviewImage}"
                   Stretch="None"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"/>
          </ScrollViewer>
        </Panel>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding StatusBrush}"/>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding ResultSize}" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      </Grid>
    </Grid>

    <!-- Options -->
    <Border Background="{DynamicResource XerahS.Brush.Overlay.Modal}" IsVisible="{Binding IsOptionsOpen}">
      <Border Width="500" MaxHeight="620" Padding="20" CornerRadius="6"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="Scrolling capture options" FontWeight="SemiBold" FontSize="16"/>
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <TextBlock Grid.Row="0" Text="Start delay:" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding StartDelay}" Minimum="100" Maximum="5000" Increment="100" FormatString="0"
                           AutomationProperties.Name="Start delay"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="ms" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Text="Scroll delay:" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ScrollDelay}" Minimum="100" Maximum="5000" Increment="100" FormatString="0"
                           AutomationProperties.Name="Scroll delay"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" Text="Scroll method:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding ScrollMethods}" SelectedItem="{Binding ScrollMethod}"
                      AutomationProperties.Name="Scroll method">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="pa:ScrollMethod">
                  <TextBlock Text="{Binding Converter={x:Static ui:ScrollingCaptureWindow.ScrollMethodNameConverter}}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="3" Text="Scroll amount:" VerticalAlignment="Center" IsVisible="{Binding IsScrollAmountVisible}"/>
            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding ScrollAmount}" Minimum="1" Maximum="6" Increment="1" FormatString="0"
                           IsVisible="{Binding IsScrollAmountVisible}" AutomationProperties.Name="Scroll amount"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="times" VerticalAlignment="Center" IsVisible="{Binding IsScrollAmountVisible}"/>
          </Grid>
          <StackPanel Spacing="8">
            <CheckBox Content="Automatically scroll to top" IsChecked="{Binding AutoScrollTop}"/>
            <CheckBox Content="Auto ignore bottom edge" IsChecked="{Binding AutoIgnoreBottomEdge}"/>
            <CheckBox Content="Show scrolling capture region" IsChecked="{Binding ShowRegion}"/>
            <CheckBox Content="Automatically upload / save" IsChecked="{Binding AutoUpload}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelOptionsCommand}"/>
            <Button Content="OK" Classes="accent" Command="{Binding SaveOptionsCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</ui:SurfaceWindow>
