<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XerahS.UI.ViewModels"
             x:Class="XerahS.UI.Views.HistoryStatsDialog"
             x:DataType="vm:HistoryStatsViewModel"
             Width="640">

    <Design.DataContext>
        <vm:HistoryStatsViewModel/>
    </Design.DataContext>

    <!-- ShareX's "History statistics" dialog. -->
    <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="History statistics" Theme="{StaticResource SubtitleTextBlockStyle}"/>
        <TextBox Grid.Row="1" Text="{Binding Text}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 Height="420"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="History statistics"/>
        <Button Grid.Row="2" Content="Close" Command="{Binding CloseCommand}" HorizontalAlignment="Right" IsCancel="True" IsDefault="True"/>
    </Grid>
</UserControl>
