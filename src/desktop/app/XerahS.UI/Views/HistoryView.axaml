<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:views="using:XerahS.UI.Views"
                xmlns:controls="using:XerahS.UI.Controls"
                xmlns:vm="using:XerahS.UI.ViewModels"
                xmlns:uiconverters="clr-namespace:XerahS.UI.Converters"
                xmlns:history="using:XerahS.History"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
                x:Class="XerahS.UI.Views.HistoryView"
                x:DataType="vm:HistoryViewModel"
                x:Name="Root"
                Cursor="Arrow"
                Loaded="OnHistoryLoaded" Unloaded="OnHistoryUnloaded">
    
    <Design.DataContext>
        <vm:HistoryViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="16" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="12">
                <WrapPanel Orientation="Horizontal">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search history (* and ? supported)"
                             IsEnabled="{Binding CanSearch}"
                             Margin="0,0,8,0"
                             MinWidth="260"
                             AutomationProperties.Name="Search History"/>
                    <Button Content="Search" Margin="0,0,8,0"
                            Command="{Binding SearchHistoryCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            AutomationProperties.Name="Search History"/>
                    <Button Content="Clear"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding IsSearchActive}"
                            IsEnabled="{Binding !IsLoading}"
                            AutomationProperties.Name="Clear History Search"/>

                    <ToggleButton Content="Favorites" IsChecked="{Binding FavoritesOnly}" Margin="8,0"
                                  AutomationProperties.Name="Show favorites"/>
                    <Button Content="Options" Margin="0,0,8,0">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ScrollViewer MaxHeight="520">
                                    <StackPanel Spacing="10" Margin="8" MinWidth="300">
                                        <CheckBox Content="Remember search text" IsChecked="{Binding RememberSearchText}"/>
                                        <StackPanel Spacing="10" IsVisible="{Binding IsGridView}">
                                            <CheckBox Content="Auto-load more items" IsChecked="{Binding AutoLoadMoreItems}"/>
                                            <CheckBox Content="Hide missing files" IsChecked="{Binding HideMissingFiles}"/>
                                            <CheckBox Content="Images only" IsChecked="{Binding ImagesOnly}"/>
                                            <TextBlock Text="Thumbnail size"/>
                                            <Grid ColumnDefinitions="*,Auto,*">
                                                <NumericUpDown Value="{Binding ThumbnailWidth}" Minimum="32" Maximum="800" Increment="10"
                                                               AutomationProperties.Name="Thumbnail width"/>
                                                <TextBlock Grid.Column="1" Text="×" Margin="8" VerticalAlignment="Center"/>
                                                <NumericUpDown Grid.Column="2" Value="{Binding ThumbnailHeight}" Minimum="32" Maximum="800" Increment="10"
                                                               AutomationProperties.Name="Thumbnail height"/>
                                            </Grid>
                                            <TextBlock Text="Thumbnail header position"/>
                                            <ComboBox ItemsSource="{Binding ThumbnailHeaderPositions}" SelectedItem="{Binding ThumbnailHeaderPosition}"
                                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Thumbnail header position"/>
                                            <TextBlock Text="Items per load (0 = all)"/>
                                            <NumericUpDown Value="{Binding ImageBatchSize}" Minimum="0" Maximum="100000" Increment="50"
                                                           AutomationProperties.Name="Items per load"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Content="Refresh" Command="{Binding RefreshHistoryCommand}" 
                            IsEnabled="{Binding !IsLoading}"
                            AutomationProperties.Name="Refresh History"/>
                    <!-- List View button: shown when grid view is active -->
                    <Button Command="{Binding ToggleViewCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            IsVisible="{Binding IsGridView}"
                            AutomationProperties.Name="Switch to List View">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE1D1;"
                                       FontFamily="avares://ShareX.ImageEditor/Assets#lucide"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="List View" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Grid View button: shown when list view is active -->
                    <Button Command="{Binding ToggleViewCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            IsVisible="{Binding !IsGridView}"
                            AutomationProperties.Name="Switch to Grid View">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE4FF;"
                                       FontFamily="avares://ShareX.ImageEditor/Assets#lucide"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Grid View" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Border Width="1" Height="20" Margin="12,0"
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <TextBlock Text="{Binding HistoryItems.Count, StringFormat='{}{0} items'}" 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    
                </WrapPanel>

                <Expander Header="Filters" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <WrapPanel IsEnabled="{Binding CanUseAdvancedFilters}">
                            <CheckBox Content="Date range" IsChecked="{Binding FilterDate}" Margin="0,0,12,8"/>
                            <DatePicker SelectedDate="{Binding FromDate}" IsEnabled="{Binding FilterDate}" Margin="0,0,8,8"
                                        AutomationProperties.Name="From date"/>
                            <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,8,8"/>
                            <DatePicker SelectedDate="{Binding ToDate}" IsEnabled="{Binding FilterDate}" Margin="0,0,8,8"
                                        AutomationProperties.Name="To date"/>
                        </WrapPanel>
                        <TextBlock Text="The start date must be on or before the end date." IsVisible="{Binding IsDateRangeInvalid}"/>
                        <WrapPanel IsEnabled="{Binding CanUseAdvancedFilters}">
                            <CheckBox Content="Type" IsChecked="{Binding FilterType}" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}" MinWidth="120"
                                      IsEnabled="{Binding FilterType}" Margin="0,0,16,0" AutomationProperties.Name="File type"/>
                            <CheckBox Content="Host" IsChecked="{Binding FilterHost}" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding HostFilter}" IsEnabled="{Binding FilterHost}" MinWidth="160"
                                     PlaceholderText="Host contains" AutomationProperties.Name="Host"/>
                        </WrapPanel>
                        <Button Content="Reset filters" Command="{Binding ResetFiltersCommand}"/>
                    </StackPanel>
                </Expander>

                <StackPanel Orientation="Horizontal"
                            Spacing="12"
                            IsVisible="{Binding ShowCombineActions}">
                    <TextBlock Text="{Binding CombineSelectionSummary}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button Content="Combine Horizontal"
                            Command="{Binding CombineHorizontalCommand}"
                            IsEnabled="{Binding !IsCombiningSelection}"
                            AutomationProperties.Name="Combine images horizontally"/>
                    <Button Content="Combine Vertical"
                            Command="{Binding CombineVerticalCommand}"
                            IsEnabled="{Binding !IsCombiningSelection}"
                            AutomationProperties.Name="Combine images vertically"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Loading State -->
        <Border Grid.Row="2" IsVisible="{Binding IsLoading}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="Loading history..." HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>
        
        <!-- List View Header -->
        <Border Grid.Row="1" Padding="16,8" Background="{DynamicResource LayerFillColorDefaultBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding !IsGridView}" IsEnabled="{Binding !IsLoading}">
            <Grid ColumnDefinitions="48, *, 160, 220">
                <TextBlock Grid.Column="1" Text="Filename" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="Type / Host" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="Date" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>

        <!-- Grid View -->
        <ListBox x:Name="GridHistoryListBox"
                 Grid.Row="2"
                 ItemsSource="{Binding HistoryItems}"
                 IsVisible="{Binding IsGridView}"
                 IsEnabled="{Binding !IsLoading}"
                 Margin="16"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Multiple"
                 SelectionChanged="OnHistorySelectionChanged"
                 AutomationProperties.Name="History Grid">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="history:HistoryItem">
                    <Border Classes="history-grid-item"
                            Margin="8" Width="{Binding #Root.((vm:HistoryViewModel)DataContext).ThumbnailCardWidth}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4" 
                            Padding="12"
                            Cursor="Hand"
                            DoubleTapped="OnItemDoubleTapped"
                            ContextFlyout="{StaticResource HistoryItemMenuFlyout}"
                            AutomationProperties.Name="{Binding FileName, StringFormat='History Item: {0}'}">
                        <Border.Tag>
                            <MultiBinding Converter="{x:Static uiconverters:HistoryItemMenuContextConverter.Instance}">
                                <Binding/>
                                <Binding ElementName="Root" Path="DataContext"/>
                            </MultiBinding>
                        </Border.Tag>
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding #Root.((vm:HistoryViewModel)DataContext).ShowTopThumbnailHeader}"/>
                            <!-- Thumbnail -->
                            <Border Height="{Binding #Root.((vm:HistoryViewModel)DataContext).ThumbnailHeight}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="4" ClipToBounds="True">
                                <Grid>
                                    <controls:HistoryThumbnail FilePath="{Binding FilePath}"
                                                               DecodeWidth="{Binding #Root.((vm:HistoryViewModel)DataContext).ThumbnailWidth}" Stretch="Uniform"/>
                                    <TextBlock Text="★" IsVisible="{Binding Favorite}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                               Margin="6" FontSize="20" Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                               AutomationProperties.Name="Favorite"/>
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="44"
                                            Height="44"
                                            CornerRadius="22"
                                            Background="#B8181818"
                                            IsHitTestVisible="False"
                                            IsVisible="{Binding IsVideo}"
                                            AutomationProperties.Name="Video recording">
                                        <TextBlock Text="▶"
                                                   FontSize="16"
                                                   Foreground="#A9A9A9"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="3,0,0,1"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="6"
                                            Padding="6,3"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            IsVisible="{Binding HasEditableAnnotations}"
                                            AutomationProperties.Name="Editable annotations available">
                                        <TextBlock Text="Edit"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- As in ShareX, the header is the file name, above or below the thumbnail. -->
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding #Root.((vm:HistoryViewModel)DataContext).ShowBottomThumbnailHeader}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected Border.history-grid-item">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Style>
            </ListBox.Styles>
        </ListBox>
        
        <!-- List View -->
        <ListBox x:Name="ListHistoryListBox"
                 Grid.Row="2"
                 ItemsSource="{Binding HistoryItems}"
                 IsVisible="{Binding !IsGridView}"
                 IsEnabled="{Binding !IsLoading}"
                 Padding="0,8"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Multiple"
                 SelectionChanged="OnHistorySelectionChanged"
                 AutomationProperties.Name="History List">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="history:HistoryItem">
                    <Border Classes="history-list-item"
                            Padding="16,8" Background="Transparent" Cursor="Hand"
                            DoubleTapped="OnItemDoubleTapped"
                            ContextFlyout="{StaticResource HistoryItemMenuFlyout}"
                            AutomationProperties.Name="{Binding FileName, StringFormat='History Item: {0}'}">
                        <Border.Tag>
                            <MultiBinding Converter="{x:Static uiconverters:HistoryItemMenuContextConverter.Instance}">
                                <Binding/>
                                <Binding ElementName="Root" Path="DataContext"/>
                            </MultiBinding>
                        </Border.Tag>
                        <Border.Styles>
                            <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Style>
                        </Border.Styles>
                        <Grid ColumnDefinitions="48, *, 160, 220">
                            <!-- Thumbnail -->
                            <Border Grid.Column="0" Width="36" Height="36" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="4" ClipToBounds="True">
                                <Grid>
                                    <controls:HistoryThumbnail FilePath="{Binding FilePath}" DecodeWidth="72" Stretch="UniformToFill"/>
                                    <Border HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Width="18"
                                            Height="18"
                                            CornerRadius="9"
                                            Background="#B8181818"
                                            IsHitTestVisible="False"
                                            IsVisible="{Binding IsVideo}"
                                            AutomationProperties.Name="Video recording">
                                        <TextBlock Text="▶"
                                                   FontSize="8"
                                                   Foreground="#A9A9A9"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="1,0,0,0"/>
                                    </Border>
                                    <Border HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Width="10"
                                            Height="10"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            IsVisible="{Binding HasEditableAnnotations}"
                                            AutomationProperties.Name="Editable annotations available"/>
                                </Grid>
                            </Border>
                            <!-- Filename -->
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="16,0">
                                <TextBlock Text="★" IsVisible="{Binding Favorite}" Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" AutomationProperties.Name="Favorite"/>
                                <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <!-- Type/Host -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="{Binding Type}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           IsVisible="{Binding Host, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <!-- DateTime -->
                            <TextBlock Grid.Column="3" Text="{Binding DateTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" 
                                       VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:selected Border.history-list-item">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                </Style>
            </ListBox.Styles>
        </ListBox>

        <!-- Pagination Footer -->
        <Border Grid.Row="3" Padding="16" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24" IsVisible="{Binding !IsGridView}">
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" 
                        IsEnabled="{Binding CanGoPrevious}"
                        AutomationProperties.Name="Previous Page"/>
                
                <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                
                <Button Content="Next" Command="{Binding NextPageCommand}" 
                        IsEnabled="{Binding CanGoNext}"
                        AutomationProperties.Name="Next Page"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24" IsVisible="{Binding IsGridView}">
                <TextBlock Text="{Binding ImageBatchInfo}" VerticalAlignment="Center"/>
                <Button Content="Load more" Command="{Binding LoadMoreItemsCommand}" IsVisible="{Binding CanLoadMoreItems}"
                        IsEnabled="{Binding !IsLoading}" AutomationProperties.Name="Load more history items"/>
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</views:PageView>
