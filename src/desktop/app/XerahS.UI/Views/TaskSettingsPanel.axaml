<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.ViewModels"
             xmlns:core="using:XerahS.Core"
             xmlns:uploaders="using:XerahS.Uploaders.PluginSystem"
             xmlns:views="using:XerahS.UI.Views"
             xmlns:controls="using:XerahS.UI.Controls"
             xmlns:converters="using:XerahS.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="XerahS.UI.Views.TaskSettingsPanel"
             x:DataType="vm:TaskSettingsViewModel">

    <Design.DataContext>
        <vm:TaskSettingsViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <TabControl Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" MinHeight="300" SelectedIndex="{Binding SelectedTabIndex}">
            
            <!-- Capture Tab -->
            <TabItem Header="Capture">
                <ScrollViewer>
                    <StackPanel Spacing="24" Margin="20">
                        <CheckBox Content="Override capture settings"
                                  IsChecked="{Binding OverrideCaptureSettings}"
                                  IsVisible="{Binding ShowOverrideSettings}"
                                  ToolTip.Tip="When off, this workflow uses the capture settings from Settings &gt; Task Settings."/>
                        <!-- General Capture Settings -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="General" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16" IsEnabled="{Binding CaptureSettingsEnabled}">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding UseModernCapture}"
                                              Content="Use modern screen capture (Direct3D11)"
                                              IsVisible="{Binding ShowUseModernCaptureSetting}"/>
                                    <CheckBox IsChecked="{Binding HDRScreenshotColorCorrection}"
                                              Content="Correct HDR display colors"
                                              IsVisible="{Binding ShowUseModernCaptureSetting}"
                                              AutomationProperties.Name="Correct HDR Display Colors"/>
                                    <StackPanel Spacing="10" IsVisible="{Binding IsLinuxPlatform}">
                                        <TextBlock Text="Preferred Linux region selector:" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding LinuxRegionSelectorPreferences}"
                                                  SelectedItem="{Binding LinuxRegionSelectorPreference}"
                                                  HorizontalAlignment="Stretch"
                                                  MinWidth="240"
                                                  AutomationProperties.Name="Preferred Linux Region Selector">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:Object">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="Automatic keeps the current safe Linux fallback behavior and only prefers a specific native selector when requested. On Hyprland with OmaSnap available, Automatic captures through OmaSnap."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                        <CheckBox IsChecked="{Binding OmaSnapRegionOnly}"
                                                  IsVisible="{Binding IsOmaSnapAvailable}"
                                                  Content="OmaSnap: region only (skip smart window and monitor selection)"
                                                  AutomationProperties.Name="OmaSnap Region Only"/>
                                    </StackPanel>
                                    <StackPanel Spacing="10" IsVisible="{Binding IsMacOSPlatform}">
                                        <TextBlock Text="Preferred macOS region selector:" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding MacOSRegionSelectorPreferences}"
                                                  SelectedItem="{Binding MacOSRegionSelectorPreference}"
                                                  HorizontalAlignment="Stretch"
                                                  MinWidth="240"
                                                  AutomationProperties.Name="Preferred macOS Region Selector">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="x:Object">
                                                    <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="Automatic follows Application Settings. Choose XerahS overlay or macOS native crosshair here to override this workflow only."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                                   TextWrapping="Wrap"/>
                                        <CheckBox IsChecked="{Binding MacOSPlayCaptureSound}"
                                                  Content="Play native macOS capture sound"
                                                  AutomationProperties.Name="Play Native macOS Capture Sound"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding ShowCursor}" Content="Show cursor in screenshots"/>
                                    
                                    <Grid ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, Auto, Auto">
                                        <!-- Screenshot Delay -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Screenshot delay:" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <NumericUpDown Value="{Binding ScreenshotDelay}" Minimum="0" Maximum="60" Increment="0.1" FormatString="0.0" MinWidth="120" HorizontalAlignment="Stretch" AutomationProperties.Name="Screenshot Delay"/>
                                            <TextBlock Text="seconds" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Window Title -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Window title:" VerticalAlignment="Center" Margin="0,16,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CaptureCustomWindow, UpdateSourceTrigger=PropertyChanged}" 
                                                 PlaceholderText="Window title to capture (CustomWindow job)" Margin="0,16,0,0" AutomationProperties.Name="Window Title"/>
                                    </Grid>

                                    <StackPanel Spacing="10">
                                        <CheckBox IsChecked="{Binding CaptureTransparent}" Content="Capture transparency"/>
                                        <CheckBox IsChecked="{Binding CaptureShadow}" Content="Capture window shadow" IsEnabled="{Binding CaptureTransparent}" Margin="24,0,0,0"/>
                                        <CheckBox IsChecked="{Binding CaptureClientArea}" Content="Capture client area (remove window chrome)"/>
                                        <CheckBox IsChecked="{Binding CaptureAutoHideTaskbar}" Content="Auto hide taskbar during capture"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Region Capture Section -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Region capture" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16" IsEnabled="{Binding CaptureSettingsEnabled}">
                                <StackPanel Spacing="10">
                                    <CheckBox IsChecked="{Binding RegionCaptureQuickCapture}" Content="Quick capture"/>
                                    <CheckBox IsChecked="{Binding RegionCaptureActiveMonitorMode}" Content="Active monitor only"/>
                                    <!-- An advanced setting in ShareX, so it follows "Override advanced settings". -->
                                    <CheckBox IsChecked="{Binding RegionCaptureDisableAnnotation}" Content="Disable annotation" IsEnabled="{Binding AdvancedSettingsEnabled}"/>
                                    <CheckBox IsChecked="{Binding RegionCaptureUseDimming}" Content="Dim background"/>
                                    <Grid ColumnDefinitions="Auto,16,*,Auto" Margin="24,0,0,0" IsEnabled="{Binding RegionCaptureUseDimming}">
                                        <TextBlock Text="Dim strength:" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="2" Value="{Binding RegionCaptureBackgroundDimStrength}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Background Dim Strength"/>
                                        <TextBlock Grid.Column="3" Text="{Binding RegionCaptureBackgroundDimStrength, StringFormat='{}{0}%'}" Width="48" TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <CheckBox IsChecked="{Binding RegionCaptureShowMagnifier}" Content="Show magnifier near cursor"/>
                                    <CheckBox IsChecked="{Binding RegionCaptureUseSquareMagnifier}" Content="Use square magnifier" IsEnabled="{Binding RegionCaptureShowMagnifier}" Margin="24,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="24,0,0,0" IsEnabled="{Binding RegionCaptureShowMagnifier}">
                                        <TextBlock Text="Magnifier pixel count:" VerticalAlignment="Center"/>
                                        <NumericUpDown Value="{Binding RegionCaptureMagnifierPixelCount}" Minimum="3" Maximum="35" Increment="2" FormatString="0" MinWidth="120" AutomationProperties.Name="Magnifier Pixel Count"/>
                                    </StackPanel>
                                    <CheckBox IsChecked="{Binding RegionCaptureShowInfo}" Content="Show position and color info"/>
                                    <CheckBox IsChecked="{Binding RegionCaptureUseCustomInfoText}" Content="Use custom info text" IsEnabled="{Binding RegionCaptureShowInfo}" Margin="24,0,0,0"/>
                                    <TextBox Text="{Binding RegionCaptureCustomInfoText}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="64"
                                             Margin="24,0,0,0"
                                             IsEnabled="{Binding RegionCaptureUseCustomInfoText}"
                                             AutomationProperties.Name="Custom Info Text"/>
                                    <TextBlock Text="Tokens: $x $y $r $g $b $hex $HEX $name $c100 $m100 $y100 $k100 $r1 $g1 $b1"
                                               FontSize="12"
                                               Margin="24,0,0,0"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                               TextWrapping="Wrap"/>
                                    <CheckBox IsChecked="{Binding RegionCaptureShowScreenCrosshair}" Content="Show screen-wide crosshair"/>
                                    <CheckBox IsChecked="{Binding RegionCaptureShowCenterCrosshair}" Content="Show selection center crosshair"/>
                                    <Grid ColumnDefinitions="Auto,16,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <Grid.DataTemplates>
                                            <DataTemplate DataType="core:RegionCaptureAction" x:DataType="core:RegionCaptureAction">
                                                <TextBlock Text="{Binding ., Converter={StaticResource EnumToDescriptionConverter}}" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </Grid.DataTemplates>
                                        <TextBlock Text="Right click:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding RegionCaptureMouseActions}" SelectedItem="{Binding RegionCaptureRightClickAction}" HorizontalAlignment="Stretch" AutomationProperties.Name="Region Capture Right Click Action"/>
                                        <TextBlock Grid.Row="1" Text="Middle click:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding RegionCaptureMouseActions}" SelectedItem="{Binding RegionCaptureMiddleClickAction}" HorizontalAlignment="Stretch" Margin="0,8,0,0" AutomationProperties.Name="Region Capture Middle Click Action"/>
                                        <TextBlock Grid.Row="2" Text="X1 click:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding RegionCaptureMouseActions}" SelectedItem="{Binding RegionCaptureX1ClickAction}" HorizontalAlignment="Stretch" Margin="0,8,0,0" AutomationProperties.Name="Region Capture X1 Click Action"/>
                                        <TextBlock Grid.Row="3" Text="X2 click:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding RegionCaptureMouseActions}" SelectedItem="{Binding RegionCaptureX2ClickAction}" HorizontalAlignment="Stretch" Margin="0,8,0,0" AutomationProperties.Name="Region Capture X2 Click Action"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- After Capture Tasks Section -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="After capture" FontWeight="SemiBold"/>
                            <CheckBox Content="Override after capture tasks"
                                  IsChecked="{Binding OverrideAfterCaptureTasks}"
                                  IsVisible="{Binding ShowOverrideSettings}"
                                  ToolTip.Tip="When off, this workflow uses the after capture tasks from Settings &gt; Task Settings."/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16" IsEnabled="{Binding AfterCaptureTasksEnabled}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Choose actions to perform automatically after capturing" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                               Margin="0,0,0,4"/>
                                    
                                    <CheckBox IsChecked="{Binding ShowQuickTaskMenu}" Content="Show quick task menu"/>
                                    <CheckBox IsChecked="{Binding ShowAfterCaptureWindow}" Content="Show after capture window"/>
                                    <CheckBox IsChecked="{Binding BeautifyImage}" Content="Beautify image"/>
                                    <CheckBox IsChecked="{Binding ApplyImageEffects}" Content="Add image effects"/>
                                    <CheckBox IsChecked="{Binding AnnotateMedia}" Content="Annotate media"/>
                                    <CheckBox IsChecked="{Binding CopyImageToClipboard}" Content="Copy image to clipboard"/>
                                    <CheckBox IsChecked="{Binding PinToScreen}" Content="Pin to screen"/>
                                    <CheckBox IsChecked="{Binding SendImageToPrinter}" Content="Print image"/>
                                    <CheckBox IsChecked="{Binding SaveImageToFile}" Content="Save image to file"/>
                                    <CheckBox IsChecked="{Binding SaveImageToFileWithDialog}" Content="Save image to file (with dialog)"/>
                                    <CheckBox IsChecked="{Binding SaveThumbnailImageToFile}" Content="Save thumbnail image to file"
                                              ToolTip.Tip="Used together with saving or uploading an image. Configure its size and suffix in Image settings."/>
                                    <CheckBox IsChecked="{Binding PerformActions}" Content="Perform actions"/>
                                    <CheckBox IsChecked="{Binding CopyFileToClipboard}" Content="Copy file to clipboard"/>
                                    <CheckBox IsChecked="{Binding CopyFilePathToClipboard}" Content="Copy file path to clipboard"/>
                                    <CheckBox IsChecked="{Binding CopyFolderPathToClipboard}" Content="Copy folder path to clipboard"/>
                                    <CheckBox IsChecked="{Binding ShowInExplorer}" Content="Show in file manager"/>
                                    <CheckBox IsChecked="{Binding ScanQRCode}" Content="Scan QR code"/>
                                    <CheckBox IsChecked="{Binding DoOCR}" Content="OCR text recognition"/>
                                    <CheckBox IsChecked="{Binding CopyOcrTextToClipboard}" Content="Copy OCR text to clipboard"/>
                                    <CheckBox IsChecked="{Binding ShowBeforeUploadWindow}" Content="Show before-upload window"/>
                                    <CheckBox IsChecked="{Binding UploadImageToHost}" Content="Upload image to host"/>
                                    <CheckBox IsChecked="{Binding DeleteFile}" Content="Delete file"
                                              ToolTip.Tip="Delete the task file at the end, including if an upload fails or is cancelled."/>
                                    <Button Content="Edit quick task menu..." Command="{Binding EditQuickTaskMenuCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- The workflow editor shows these in its own tabs; the default page shows them here. -->
            <TabItem Header="Image" IsVisible="{Binding ShowMediaSettingsTabs}">
                <views:TaskImageSettingsPanel/>
            </TabItem>
            <TabItem Header="Video" IsVisible="{Binding ShowMediaSettingsTabs}">
                <views:TaskVideoSettingsPanel/>
            </TabItem>

            <TabItem Header="Actions">
                <views:TaskActionsSettingsPanel/>
            </TabItem>

            <!-- Index Folder Tab (Conditional) -->
            <TabItem Header="Index Folder" IsVisible="{Binding ShowIndexFolderTab}">
                <ScrollViewer>
                     <StackPanel Spacing="8" Margin="20">
                        <CheckBox Content="Override tools settings"
                                  IsChecked="{Binding OverrideToolsSettings}"
                                  IsVisible="{Binding ShowOverrideToolsSettings}"
                                  Margin="0,0,0,8"
                                  ToolTip.Tip="When off, this workflow uses the tools settings from Settings > Task Settings."/>
                        <TextBlock Text="Index folder" FontWeight="SemiBold"/>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16"
                                IsEnabled="{Binding ToolsSettingsEnabled}">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="Auto, 16, *, Auto">
                                    <TextBlock Grid.Column="0" Text="Folder:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding IndexerFolderPath}" PlaceholderText="Folder to index" AutomationProperties.Name="Indexer Folder"/>
                                    <Button Grid.Column="3" Content="Browse..." Command="{Binding BrowseIndexerFolderCommand}" Margin="16,0,0,0"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto, 16, *">
                                    <TextBlock Grid.Column="0" Text="Output:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding IndexerOutputs}" SelectedItem="{Binding IndexerOutput}" MinWidth="200" HorizontalAlignment="Stretch" AutomationProperties.Name="Indexer Output Format"/>
                                </Grid>

                                <Grid ColumnDefinitions="Auto, 16, *">
                                    <TextBlock Grid.Column="0" Text="Max depth:" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="2" Value="{Binding IndexerMaxDepthLevel}" Minimum="0" Maximum="50" MinWidth="120" HorizontalAlignment="Stretch" AutomationProperties.Name="Max Depth Level"/>
                                </Grid>

                                <StackPanel Spacing="10">
                                    <CheckBox IsChecked="{Binding IndexerSkipHiddenFolders}" Content="Skip hidden folders"/>
                                    <CheckBox IsChecked="{Binding IndexerSkipHiddenFiles}" Content="Skip hidden files"/>
                                    <CheckBox IsChecked="{Binding IndexerSkipFiles}" Content="Skip files"/>
                                    <CheckBox IsChecked="{Binding IndexerShowSizeInfo}" Content="Show size info"/>
                                    <CheckBox IsChecked="{Binding IndexerAddFooter}" Content="Add footer"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="Auto, 16, *">
                                    <TextBlock Grid.Column="0" Text="Indentation:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding IndexerIndentationText}" MinWidth="200" HorizontalAlignment="Stretch" AutomationProperties.Name="Indentation Text"/>
                                </Grid>

                                <CheckBox IsChecked="{Binding IndexerAddEmptyLineAfterFolders}" Content="Add empty line after folders"/>

                                <Separator Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Height="1"/>
                                
                                <TextBlock Text="HTML options" FontWeight="SemiBold" FontSize="12"/>
                                <CheckBox IsChecked="{Binding IndexerUseCustomCssFile}" Content="Use custom CSS file"/>
                                
                                <Grid ColumnDefinitions="Auto, 16, *, Auto" IsEnabled="{Binding IndexerUseCustomCssFile}">
                                    <TextBlock Grid.Column="0" Text="CSS path:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="2" Text="{Binding IndexerCustomCssFilePath}" AutomationProperties.Name="CSS File Path"/>
                                    <Button Grid.Column="3" Content="Browse..." Command="{Binding BrowseIndexerCssFileCommand}" Margin="16,0,0,0"/>
                                </Grid>
                                
                                <CheckBox IsChecked="{Binding IndexerDisplayPath}" Content="Display path for subfolders"/>
                                <CheckBox IsChecked="{Binding IndexerDisplayPathLimited}"
                                          Content="Limit display path to root folder"
                                          IsEnabled="{Binding IndexerDisplayPath}"
                                          Margin="24,0,0,0"/>

                                <Separator Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Height="1"/>
                                
                                <TextBlock Text="XML / JSON options" FontWeight="SemiBold" FontSize="12"/>
                                <StackPanel Spacing="10">
                                    <CheckBox IsChecked="{Binding IndexerUseAttribute}" Content="Write file info as attribute (XML)"/>
                                    <CheckBox IsChecked="{Binding IndexerCreateParseableJson}" Content="Create parseable JSON"/>
                                    <CheckBox IsChecked="{Binding IndexerBinaryUnits}" Content="Use binary units for size"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- File Tab (New) -->
            <TabItem Header="File">
                <ScrollViewer>
                     <StackPanel Spacing="8" Margin="20">
                        <TextBlock Text="File naming" FontWeight="SemiBold"/>
                        <CheckBox Content="Override upload settings"
                                  IsChecked="{Binding OverrideUploadSettings}"
                                  IsVisible="{Binding ShowOverrideSettings}"
                                  ToolTip.Tip="When off, this workflow uses the upload settings (file naming and clipboard upload) from Settings &gt; Task Settings."/>
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16" IsEnabled="{Binding UploadSettingsEnabled}">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="Auto, 16, *">
                                    <TextBlock Grid.Column="0" Text="Name pattern:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="NameFormatPatternTextBox" Grid.Column="2" Text="{Binding NameFormatPattern, Mode=TwoWay}" AutomationProperties.Name="Name Pattern"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto, 16, *">
                                    <TextBlock Grid.Column="0" Text="Active window name pattern:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="NameFormatPatternActiveWindowTextBox" Grid.Column="2" Text="{Binding NameFormatPatternActiveWindow, Mode=TwoWay}" AutomationProperties.Name="Active Window Name Pattern"/>
                                </Grid>
                                
                                <StackPanel Spacing="10">
                                    <CheckBox IsChecked="{Binding FileUploadUseNamePattern}" Content="Use name pattern for file uploaders"/>
                                    <CheckBox IsChecked="{Binding FileUploadReplaceProblematicCharacters}" Content="Replace potentially problematic characters"/>
                                    <CheckBox IsChecked="{Binding URLRegexReplace}" Content="Perform regex replace on URL"/>
                                </StackPanel>
                                
                                <Grid ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, 16, Auto" IsVisible="{Binding URLRegexReplace}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Regex pattern:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding URLRegexReplacePattern, Mode=TwoWay}" AutomationProperties.Name="URL Regex Pattern"/>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Replacement:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding URLRegexReplaceReplacement, Mode=TwoWay}" AutomationProperties.Name="URL Regex Replacement"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Upload Tab -->
            <TabItem Header="Upload">
               <ScrollViewer>
                   <StackPanel Spacing="24" Margin="20">
                        <!-- Destinations Section (New) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Destinations" FontWeight="SemiBold"/>
                            <CheckBox Content="Override destinations"
                                  IsChecked="{Binding OverrideDestinations}"
                                  IsVisible="{Binding ShowOverrideSettings}"
                                  ToolTip.Tip="When off, this workflow uses the destination from Settings &gt; Task Settings."/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16" IsEnabled="{Binding DestinationsEnabled}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Select the destination for this task:" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding $parent[views:WorkflowEditorView].((vm:WorkflowEditorViewModel)DataContext).AvailableDestinations}"
                                              SelectedItem="{Binding $parent[views:WorkflowEditorView].((vm:WorkflowEditorViewModel)DataContext).SelectedDestination}"
                                              HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Select Destination"
                                              ToolTip.Tip="Auto tries your configured uploaders in order until one succeeds. Any other destination uploads only to that uploader (configure it under Destination Settings). See documentation for details on image uploads and fallback behavior.">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:UploaderInstanceViewModel">
                                                 <StackPanel Orientation="Horizontal" Spacing="8">
                                                     <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                 </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <StackPanel Spacing="8" IsVisible="{Binding ShowAfterUploadShortenerDestination}">
                                        <TextBlock Text="URL shortener:"/>
                                        <ComboBox ItemsSource="{Binding UrlShortenerDestinations}"
                                                  SelectedItem="{Binding SelectedUrlShortenerDestination}"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Select URL Shortener"
                                                  ToolTip.Tip="Used by Shorten URL after upload. Configure URL shorteners in Destination Settings.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="uploaders:UploaderInstance">
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="URL sharing service:"/>
                                        <ComboBox ItemsSource="{Binding UrlSharingDestinations}"
                                                  SelectedItem="{Binding SelectedUrlSharingDestination}"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Select URL Sharing Service"
                                                  ToolTip.Tip="Used by Share URL. Configure URL sharing services in Destination Settings.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="uploaders:UploaderInstance">
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Clipboard Upload -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Clipboard upload" FontWeight="SemiBold"/>
                            <CheckBox Content="Override upload settings"
                                  IsChecked="{Binding OverrideUploadSettings}"
                                  IsVisible="{Binding ShowOverrideSettings}"
                                  ToolTip.Tip="When off, this workflow uses the upload settings (file naming and clipboard upload) from Settings &gt; Task Settings."/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16" IsEnabled="{Binding UploadSettingsEnabled}">
                                <StackPanel Spacing="10">
                                    <CheckBox IsChecked="{Binding ClipboardUploadURLContents}" Content="Upload URL contents"/>
                                    <CheckBox IsChecked="{Binding ClipboardUploadShortenURL}" Content="Shorten URL"/>
                                    <CheckBox IsChecked="{Binding ClipboardUploadShareURL}" Content="Share URL"
                                              ToolTip.Tip="If the clipboard contains a URL, share it with the URL sharing service. Upload URL contents and Shorten URL take precedence, as in ShareX."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- After Upload Tasks -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="After upload" FontWeight="SemiBold"/>
                            <CheckBox Content="Override after upload tasks"
                                  IsChecked="{Binding OverrideAfterUploadTasks}"
                                  IsVisible="{Binding ShowOverrideSettings}"
                                  ToolTip.Tip="When off, this workflow uses the after upload tasks from Settings &gt; Task Settings."/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16" IsEnabled="{Binding AfterUploadTasksEnabled}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Choose actions to perform automatically after upload" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                               Margin="0,0,0,4"/>
                                    <CheckBox IsChecked="{Binding ShowAfterUploadWindow}" 
                                              Content="Show after upload window"
                                              AutomationProperties.Name="Show After Upload Window"/>
                                    <CheckBox IsChecked="{Binding UseURLShortener}" 
                                              Content="Shorten URL"/>
                                    <CheckBox IsChecked="{Binding ShareURL}" Content="Share URL"
                                              ToolTip.Tip="Shares the URL with the URL sharing service selected in Destinations."/>
                                    <CheckBox IsChecked="{Binding CopyURLToClipboard}"
                                              Content="Copy URL to clipboard"/>
                                    <CheckBox IsChecked="{Binding OpenURL}"
                                              Content="Open URL" AutomationProperties.Name="Open URL"/>
                                    <CheckBox IsChecked="{Binding ShowQRCode}"
                                              Content="Show QR code" AutomationProperties.Name="Show QR Code"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                   </StackPanel>
               </ScrollViewer>
            </TabItem>

            <!-- Notifications Tab (Renamed from General) -->
            <TabItem Header="Notifications">
                <ScrollViewer>
                    <StackPanel Spacing="24" Margin="20">
                        <CheckBox Content="Override general settings"
                                  IsChecked="{Binding OverrideGeneralSettings}"
                                  IsVisible="{Binding ShowOverrideSettings}"
                                  ToolTip.Tip="When off, this workflow uses the notification and sound settings from Settings &gt; Task Settings."/>
                        <!-- Notifications Section -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Notifications" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16" IsEnabled="{Binding GeneralSettingsEnabled}">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="10">
                                        <CheckBox IsChecked="{Binding PlaySoundAfterCapture}" Content="Play sound after capture"/>
                                        <CheckBox IsChecked="{Binding PlaySoundAfterUpload}" Content="Play sound after upload"/>
                                        <CheckBox IsChecked="{Binding PlaySoundAfterAction}" Content="Play sound after action"/>
                                        <CheckBox IsChecked="{Binding ShowToastNotification}" Content="Include toast notification"/>
                                    </StackPanel>
                                    
                                    <!-- Toast Settings -->
                                    <Grid ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" 
                                          IsVisible="{Binding ShowToastNotification}" Margin="24,0,0,0">
                                        
                                        <!-- Duration -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Duration:" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                            <NumericUpDown Value="{Binding ToastWindowDuration}" Minimum="0.5" Maximum="30" Increment="0.5" FormatString="0.0" MinWidth="120" AutomationProperties.Name="Toast Duration"/>
                                            <TextBlock Text="seconds" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Fade Duration -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fade duration:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                            <NumericUpDown Value="{Binding ToastWindowFadeDuration}" Minimum="0" Maximum="5" Increment="0.1" FormatString="0.0" MinWidth="120" AutomationProperties.Name="Toast Fade Duration"/>
                                            <TextBlock Text="seconds" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Placement -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Placement:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding ContentAlignments}" SelectedItem="{Binding ToastWindowPlacement}" HorizontalAlignment="Stretch" MinWidth="200" Margin="0,8,0,0" AutomationProperties.Name="Toast Placement"/>

                                        <!-- Size -->
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Size:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                            <NumericUpDown Value="{Binding ToastWindowWidth}" Minimum="100" Maximum="2000" Increment="10" MinWidth="120" AutomationProperties.Name="Toast Width"/>
                                            <TextBlock Text="x" VerticalAlignment="Center"/>
                                            <NumericUpDown Value="{Binding ToastWindowHeight}" Minimum="50" Maximum="1000" Increment="10" MinWidth="120" AutomationProperties.Name="Toast Height"/>
                                        </StackPanel>
                                        
                                        <!-- Auto Hide -->
                                         <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" IsChecked="{Binding ToastWindowAutoHide}" Content="Auto hide toast notification" Margin="0,8,0,0"/>

                                        <!-- Click Actions -->
                                        <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, Auto, Auto" Margin="0,16,0,0">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Left click:" VerticalAlignment="Center"/>
                                            <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding ToastClickActions}" SelectedItem="{Binding ToastWindowLeftClickAction}" HorizontalAlignment="Stretch" AutomationProperties.Name="Left Click Action"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Middle click:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                            <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding ToastClickActions}" SelectedItem="{Binding ToastWindowMiddleClickAction}" HorizontalAlignment="Stretch" Margin="0,8,0,0" AutomationProperties.Name="Middle Click Action"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Right click:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                            <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding ToastClickActions}" SelectedItem="{Binding ToastWindowRightClickAction}" HorizontalAlignment="Stretch" Margin="0,8,0,0" AutomationProperties.Name="Right Click Action"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Sound Section -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sound" FontWeight="SemiBold"/>
                            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16" IsEnabled="{Binding GeneralSettingsEnabled}">
                                <StackPanel Spacing="16">
                                    <CheckBox IsChecked="{Binding UseCustomCaptureSound}" Content="Use custom capture sound"/>
                                    <Grid ColumnDefinitions="Auto, 16, *" IsVisible="{Binding UseCustomCaptureSound}">
                                        <TextBlock Grid.Column="0" Text="Path:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="2" Text="{Binding CustomCaptureSoundPath}" AutomationProperties.Name="Sound File Path"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tools Tab: ShareX's Tools and Image editor pages -->
            <TabItem Header="Tools">
                <ScrollViewer>
                    <StackPanel Spacing="16" Margin="20">
                        <CheckBox Content="Override tools settings"
                                  IsChecked="{Binding OverrideToolsSettings}"
                                  IsVisible="{Binding ShowOverrideToolsSettings}"
                                  ToolTip.Tip="When off, this workflow uses the tools settings from Settings > Task Settings."/>

                        <StackPanel Spacing="16" IsEnabled="{Binding ToolsSettingsEnabled}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Screen color picker" FontWeight="SemiBold"/>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                    <Grid ColumnDefinitions="Auto, 16, *" RowDefinitions="Auto, 12, Auto, 12, Auto, 12, Auto">
                                        <TextBlock Grid.Row="0" Text="Format:" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding ScreenColorPickerFormat}" AutomationProperties.Name="Screen Color Picker Format"/>
                                        <TextBlock Grid.Row="2" Text="Format (Ctrl + click):" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding ScreenColorPickerFormatCtrl}" AutomationProperties.Name="Screen Color Picker Ctrl Format"/>
                                        <TextBlock Grid.Row="4" Text="Info text:" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                        <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding ScreenColorPickerInfoText}" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="Screen Color Picker Info Text"/>
                                        <CheckBox Grid.Row="6" Grid.ColumnSpan="3" Content="Show magnifier" IsChecked="{Binding ScreenColorPickerShowMagnifier}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Image editor" FontWeight="SemiBold"/>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                                    <StackPanel Spacing="10">
                                        <CheckBox Content="Remember window state" IsChecked="{Binding EditorOptions.RememberWindowState}"/>
                                        <CheckBox Content="Show exit confirmation" IsChecked="{Binding EditorOptions.ShowExitConfirmation}"/>
                                        <CheckBox Content="Zoom to fit on open" IsChecked="{Binding EditorOptions.ZoomToFitOnOpen}"/>
                                        <CheckBox Content="Quick crop" IsChecked="{Binding EditorOptions.QuickCrop}"/>
                                        <CheckBox Content="Auto close editor after a task" IsChecked="{Binding EditorOptions.AutoCloseEditorOnTask}"/>
                                        <CheckBox Content="Auto copy image to clipboard" IsChecked="{Binding EditorOptions.AutoCopyImageToClipboard}"/>
                                        <CheckBox Content="Show insert image dialog" IsChecked="{Binding EditorOptions.ShowInsertImageDialog}"/>
                                        <CheckBox Content="Show notifications" IsChecked="{Binding EditorOptions.ShowNotifications}"/>
                                        <Button Content="Customize toolbar..." Click="OnCustomizeEditorToolbarClick" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Advanced Tab -->
            <TabItem Header="Advanced">
                <Grid Margin="24" RowDefinitions="Auto, Auto, *">
                    <TextBlock Grid.Row="0"
                               Text="Advanced Properties"
                                FontWeight="SemiBold"
                                Margin="0,0,0,12"/>
                    <CheckBox Grid.Row="1" Margin="0,0,0,12"
                              Content="Override advanced settings"
                              IsChecked="{Binding OverrideAdvancedSettings}"
                              IsVisible="{Binding ShowOverrideSettings}"
                              ToolTip.Tip="When off, this workflow uses the advanced settings from Settings &gt; Task Settings."/>
                    <Border Grid.Row="2" IsEnabled="{Binding AdvancedSettingsEnabled}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            CornerRadius="4"
                            Padding="8">
                        <controls:PropertyGrid SelectedObject="{Binding AdvancedSettings}"
                                               AutomationProperties.Name="Advanced Task Settings"/>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
