<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="avares://ShareX.ImageEditor/Assets#lucide"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.section-heading">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="TextBlock.path-text">
        <Setter Property="Foreground" Value="{DynamicResource ShareX.Brush.Text.Secondary}"/>
    </Style>
    <Style Selector="Border.tool-panel">
        <Setter Property="Background" Value="{DynamicResource ShareX.Brush.Background.Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ShareX.Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
</Styles>
